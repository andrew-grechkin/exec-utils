#!/usr/bin/env -S bash -Eeuo pipefail

export ONCE_DIR=$(mktemp -d)
trap 'rm -rf "$ONCE_DIR"' EXIT

"$BIN" -w -l ENV -- true </dev/null >/dev/null 2>&1

# The lockfile should live under ONCE_DIR (any file that isn't . or ..).
if ! find "$ONCE_DIR" -mindepth 1 -maxdepth 1 -type f | grep -q .; then
    echo "expected a lockfile under ONCE_DIR=$ONCE_DIR, found none" >&2
    ls -la "$ONCE_DIR" >&2 || true
    exit 1
fi
