#!/usr/bin/env -S bash -Eeuo pipefail
notexec=$(mktemp)
echo '#!/bin/sh' > "$notexec"; chmod -x "$notexec"
trap 'rm -f "$notexec"' EXIT

rc=0
"$BIN" -n 1 -- "$notexec" </dev/null >/dev/null 2>&1 || rc=$?
if [[ "$rc" != "126" ]]; then
    echo "expected 126 (ExitCannotInvoke), got $rc" >&2
    exit 1
fi
