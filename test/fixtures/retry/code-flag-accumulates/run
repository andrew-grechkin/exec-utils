#!/usr/bin/env -S bash -Eeuo pipefail

mark=$(mktemp)
trap 'rm -f "$mark"' EXIT

# The payload always exits 3. If the retry set contains 3 the loop runs 5 attempts (max reached, exit 3). If it does
# not contain 3, retry stops on the first attempt (out-of-set exit) and exit stays 3 -- observable difference is the
# number of attempts recorded via the mark file.
payload='printf x >> "$1"; exit 3'

expect_attempts() {
    local expected=$1; shift
    : > "$mark"
    "$BIN" "$@" -d 20ms -- sh -c "$payload" _ "$mark" </dev/null >/dev/null 2>&1 || true
    local got; got=$(wc -c < "$mark")
    if [[ "$got" != "$expected" ]]; then
        echo "form '$*' -- expected $expected attempts, got $got" >&2
        exit 1
    fi
}

# Comma form: {1, 3} contains 3 -> 5 attempts
expect_attempts 5 -n 5 -c 1,3

# Repeated form: {1, 3} contains 3 -> 5 attempts
expect_attempts 5 -n 5 -c 1 -c 3

# Mixed form: {0, 1, 3} contains 3 -> 5 attempts
expect_attempts 5 -n 5 -c 0,1 -c 3

# Sanity: {1, 2} does NOT contain 3 -> 1 attempt (exit falls out of set)
expect_attempts 1 -n 5 -c 1,2
